# Copy to .env.local for `npm run dev` and fill in. Never commit .env.local.
TEACHER_LOGIN=
TEACHER_PASSWORD=
# 32 or more random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Optional demo student
USER_LOGIN=
USER_PASSWORD=
# Optional. Leave empty for local work: the shop database is then PGlite in .pglite/ and files go to .local-store/.
# Set only to run `npm run seed-catalog` against the real database (then Blob access is needed too).
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
